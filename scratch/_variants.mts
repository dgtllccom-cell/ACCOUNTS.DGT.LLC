        { label: "Branch Code", value: "PK-MB-0007" }, { label: "Branch Type", value: "MAIN" },
        { label: "Established On", value: D("15 Mar 2024") }, { label: "Tax Reg. No.", value: D("-") }, { label: "NTN / GST No.", value: D("-") },
      ]},
      { title: "Owner Details", rows: [
        { label: "Owner Name", value: D("Muhammad Asmatullah") }, { label: "Owner Code", value: D("OWN-0007") },
        { label: "Designation", value: D("Country Admin") }, { label: "Nationality", value: D("Pakistani") },
        { label: "Ownership Type", value: D("Individual") }, { label: "Ownership %", value: D("100%") },
      ]},
      { title: "Contact Information", rows: [
        { label: "Phone", value: D("+92 81 000 0000") }, { label: "WhatsApp", value: D("-") },
        { label: "Email", value: D("pk.branch@asmatbrothers.pk") }, { label: "Landline", value: D("-") }, { label: "Website", value: D("-") },
      ]},
      { title: "Company Details", rows: [
