{
  "appId": "com.dgtllc.bs",
  "appName": "DGT.llc BS",
  "webDir": "mobile-shell",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "appendUserAgent": "DGTllc-BS/1"
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "appendUserAgent": "DGTllc-BS/1"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f3ea8",
      "showSpinner": false,
      "androidSpinnerStyle": "large",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0f3ea8",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "server": {
    "url": "https://api.dgt.llc/auth/login",
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "api.dgt.llc"
    ],
    "errorPath": "offline.html"
  }
}
