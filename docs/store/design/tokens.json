{
  "$description": "DGT.llc B / DGT.llc BS — design tokens. SOURCE OF TRUTH for the mobile design layer. Every colour comes from the real ERP theme (app/globals.css: day / soft / green / night modes and the .theme-blue / .theme-cyan template variants) or from the Tailwind palette the ERP already uses for status badges. Nothing here is a new brand. Format: W3C design-tokens style ($type/$value) so it imports into Figma Variables (Tokens Studio, 'Variables Import' plugin or Figma's native JSON import). HSL triplets are stored as CSS 'H S% L%' strings exactly as the ERP stores them.",
  "$version": "1.0.0",
  "$generatedFrom": ["app/globals.css", "tailwind.config.ts", "app/layout.tsx", "docs/design-system.md", "docs/store/assets/{b,bs}"],

  "color": {
    "$type": "color",
    "mode": {
      "$description": "ERP theme modes (data-erp-theme-mode). 'day' is the app default (light). 'night' = dark. Each value is the ERP's HSL triplet.",
      "day": {
        "background": { "$value": "220 20% 96%" }, "foreground": { "$value": "222 47% 11%" },
        "card": { "$value": "0 0% 100%" }, "card-foreground": { "$value": "222 47% 11%" },
        "primary": { "$value": "214 78% 46%" }, "primary-foreground": { "$value": "0 0% 100%" },
        "secondary": { "$value": "220 16% 93%" }, "muted": { "$value": "220 16% 92%" }, "muted-foreground": { "$value": "215.4 16.3% 46.9%" },
        "accent": { "$value": "152 45% 42%" }, "accent-foreground": { "$value": "0 0% 100%" },
        "destructive": { "$value": "0 84.2% 60.2%" }, "border": { "$value": "214 24% 88%" }, "input": { "$value": "214 24% 88%" }, "ring": { "$value": "214 78% 46%" }
      },
      "soft": {
        "background": { "$value": "210 40% 98%" }, "foreground": { "$value": "222 47% 11%" }, "card": { "$value": "0 0% 100%" },
        "primary": { "$value": "190 83% 28%" }, "primary-foreground": { "$value": "0 0% 100%" }, "muted": { "$value": "210 20% 94%" },
        "muted-foreground": { "$value": "215.4 16.3% 46.9%" }, "accent": { "$value": "11 68% 58%" }, "destructive": { "$value": "0 84.2% 60.2%" }, "border": { "$value": "214 30% 90%" }, "ring": { "$value": "190 83% 28%" }
      },
      "green": {
        "background": { "$value": "138 28% 97%" }, "foreground": { "$value": "140 20% 11%" }, "card": { "$value": "0 0% 100%" },
        "primary": { "$value": "142 71% 32%" }, "primary-foreground": { "$value": "0 0% 100%" }, "muted": { "$value": "140 20% 92%" },
        "muted-foreground": { "$value": "145 12% 38%" }, "accent": { "$value": "158 50% 40%" }, "destructive": { "$value": "0 84.2% 60.2%" }, "border": { "$value": "141 25% 85%" }, "ring": { "$value": "142 71% 32%" }
      },
      "night": {
        "background": { "$value": "222 47% 11%" }, "foreground": { "$value": "210 40% 98%" },
        "card": { "$value": "222 47% 13%" }, "card-foreground": { "$value": "210 40% 98%" },
        "primary": { "$value": "190 83% 40%" }, "primary-foreground": { "$value": "222 47% 11%" },
        "secondary": { "$value": "222 47% 18%" }, "muted": { "$value": "222 47% 18%" }, "muted-foreground": { "$value": "215 20% 65%" },
        "accent": { "$value": "37 92% 55%" }, "accent-foreground": { "$value": "222 47% 11%" },
        "destructive": { "$value": "0 62% 40%" }, "border": { "$value": "217 33% 17%" }, "input": { "$value": "217 33% 17%" }, "ring": { "$value": "190 83% 40%" }
      }
    },
    "app": {
      "$description": "Per-app primary, using the ERP's own template variants so both apps stay inside the ERP palette. B = .theme-blue (matches the B icon + login CTA). BS = .theme-cyan (matches the BS icon's teal wave). Dark values are the .dark.theme-* variants.",
      "b":  { "primary": { "$value": "221 83% 53%" }, "primary-dark": { "$value": "221 83% 68%" }, "primary-foreground": { "$value": "0 0% 100%" }, "accent": { "$value": "38 92% 50%" }, "splash": { "$value": "#0f3ea8" }, "icon-from": { "$value": "#2563eb" }, "icon-to": { "$value": "#0f3ea8" } },
      "bs": { "primary": { "$value": "190 83% 34%" }, "primary-dark": { "$value": "190 83% 55%" }, "primary-foreground": { "$value": "0 0% 100%" }, "accent": { "$value": "38 92% 50%" }, "splash": { "$value": "#0a2a4f" }, "icon-from": { "$value": "#0e7490" }, "icon-to": { "$value": "#0a2a4f" }, "wave": { "$value": "#2dd4bf" } }
    },
    "status": {
      "$description": "Status pills. Tailwind palette values already used by ERP badges. Never colour alone — pills always carry an icon and a label.",
      "success": { "$value": "#059669" }, "success-soft": { "$value": "#d1fae5" }, "success-ink": { "$value": "#065f46" },
      "warning": { "$value": "#d97706" }, "warning-soft": { "$value": "#fef3c7" }, "warning-ink": { "$value": "#92400e" },
      "danger":  { "$value": "#dc2626" }, "danger-soft":  { "$value": "#fee2e2" }, "danger-ink":  { "$value": "#991b1b" },
      "info":    { "$value": "#2563eb" }, "info-soft":    { "$value": "#dbeafe" }, "info-ink":    { "$value": "#1e40af" },
      "neutral": { "$value": "#64748b" }, "neutral-soft": { "$value": "#e2e8f0" }, "neutral-ink": { "$value": "#334155" }
    }
  },

  "font": {
    "family": {
      "latin":  { "$type": "fontFamily", "$value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
      "arabic-script": { "$type": "fontFamily", "$value": "'Noto Sans Arabic', 'Segoe UI', Tahoma, Arial, sans-serif", "$description": "Urdu, Arabic, Farsi, Pashto (ERP --font-arabic). The ERP also loads Cairo (ar), Vazirmatn (fa) and Noto Naskh Arabic (ur/ps) as per-language overrides in app/layout.tsx." },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "scale": {
      "$type": "dimension", "$description": "px at 1x. Arabic-script text uses line-height 1.65 and the same sizes (no letter-spacing).",
      "caption": { "$value": "11px", "lineHeight": "16px" }, "label": { "$value": "12px", "lineHeight": "16px" }, "body-sm": { "$value": "13px", "lineHeight": "20px" },
      "body": { "$value": "15px", "lineHeight": "22px" }, "title-sm": { "$value": "17px", "lineHeight": "24px" }, "title": { "$value": "20px", "lineHeight": "28px" },
      "headline": { "$value": "24px", "lineHeight": "32px" }, "display": { "$value": "32px", "lineHeight": "40px" }, "kpi": { "$value": "28px", "lineHeight": "32px", "feature": "tabular-nums" }
    },
    "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }, "extrabold": { "$value": 800 } }
  },

  "space": { "$type": "dimension", "0": { "$value": "0" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" }, "gutter-phone": { "$value": "16px" }, "gutter-tablet": { "$value": "24px" } },
  "radius": { "$type": "dimension", "sm": { "$value": "8px" }, "md": { "$value": "12px", "$description": "ERP --radius 0.75rem: inputs, buttons" }, "lg": { "$value": "16px", "$description": "cards (erp-surface)" }, "xl": { "$value": "24px", "$description": "dialogs, sheets, hero" }, "pill": { "$value": "999px" } },
  "size": { "$type": "dimension", "touch-min": { "$value": "48px" }, "icon-sm": { "$value": "16px" }, "icon": { "$value": "20px" }, "icon-lg": { "$value": "24px" }, "gem": { "$value": "44px" }, "appbar": { "$value": "56px" }, "tabbar": { "$value": "64px" }, "rail": { "$value": "88px" }, "drawer": { "$value": "320px" } },
  "breakpoint": { "$type": "dimension", "phone-small": { "$value": "360px", "$description": "Samsung Galaxy S / most Android" }, "phone": { "$value": "390px", "$description": "iPhone 15/16 — design baseline" }, "phone-large": { "$value": "430px" }, "tablet": { "$value": "820px", "$description": "iPad Air / Galaxy Tab — design baseline" }, "tablet-large": { "$value": "1032px" } },

  "elevation": {
    "$description": "Layered shadows. e1–e2 are the ERP's own .erp-surface / .premium-card recipes. e3–e4 and the 3D set add the 'depth' look used by dashboard tiles: a top highlight, a coloured bottom edge, and a soft tinted drop. {tone} = the tile's HSL triplet.",
    "e0": { "$type": "shadow", "$value": "none" },
    "e1": { "$type": "shadow", "$value": "0 8px 24px -18px hsl(var(--foreground) / 0.28)", "$description": "ERP .erp-surface" },
    "e2": { "$type": "shadow", "$value": "0 4px 6px -1px hsl(var(--primary) / 0.05), 0 2px 4px -2px hsl(var(--primary) / 0.03)", "$description": "ERP .premium-card" },
    "e3": { "$type": "shadow", "$value": "0 12px 24px -10px hsl(var(--primary) / 0.12), 0 4px 12px -5px hsl(var(--primary) / 0.06)", "$description": "ERP .premium-card:hover / pressed-in-reverse" },
    "e4": { "$type": "shadow", "$value": "0 24px 48px -16px hsl(var(--foreground) / 0.35)", "$description": "bottom sheet, drawer, dialog" },
    "3d-tile": { "$type": "shadow", "$value": "inset 0 1px 0 hsl(0 0% 100% / 0.85), inset 0 -4px 0 hsl({tone} / 0.28), 0 14px 22px -10px hsl({tone} / 0.45), 0 2px 4px hsl(0 0% 0% / 0.06)", "$description": "KPI tile: light top edge, tinted base edge, tinted drop shadow" },
    "3d-gem": { "$type": "shadow", "$value": "inset 0 2px 3px hsl(0 0% 100% / 0.55), inset 0 -3px 4px hsl(0 0% 0% / 0.18), 0 8px 14px -6px hsl({tone} / 0.6)", "$description": "icon chip" },
    "3d-button": { "$type": "shadow", "$value": "inset 0 1px 0 hsl(0 0% 100% / 0.35), inset 0 -3px 0 hsl(0 0% 0% / 0.18), 0 8px 16px -8px hsl(var(--primary) / 0.7)", "$description": "primary CTA" },
    "3d-gradient": { "$type": "gradient", "$value": "linear-gradient(160deg, hsl({tone} / 0.14) 0%, hsl(var(--card)) 46%)", "$description": "tile surface" },
    "3d-gem-gradient": { "$type": "gradient", "$value": "linear-gradient(145deg, hsl({tone} / 0.78) 0%, hsl({tone}) 55%, hsl({tone} / 0.86) 100%)" }
  },

  "motion": { "$type": "duration", "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" }, "easing": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1], "$description": "ERP .premium-card easing" }, "reduced-motion": "all 3D lift/tilt effects are disabled under prefers-reduced-motion; depth is static" },

  "layout": {
    "phone": { "columns": 4, "gutter": "16px", "margin": "16px", "kpi-columns": 2, "nav": "bottom tab bar (5) + drawer", "safe-area": "respect env(safe-area-inset-*) top/bottom" },
    "tablet": { "columns": 12, "gutter": "24px", "margin": "24px", "kpi-columns": 4, "nav": "side rail (88px) + drawer; master-detail for lists", "content-max": "1100px" }
  },

  "rtl": {
    "$description": "Applies to Urdu (ur), Arabic (ar), Farsi (fa), Pashto (ps). Switch = dir=rtl on the screen root (the ERP sets document.documentElement.dir). Use logical properties only.",
    "mirror": ["app-bar order (menu leading edge → right)", "drawer + side rail dock to the right", "chevrons and back arrows", "progress / stepper direction", "bottom-tab order (reads right-to-left)", "text-align: start", "input icons switch sides", "swipe-to-reveal actions swap sides"],
    "do-not-mirror": ["numbers, amounts, dates, codes, container/BL/seal numbers, phone numbers, e-mail (set dir=ltr inline, text-align: start)", "play / media controls", "logos and app icons", "charts' value axes (only category order mirrors)", "the 6-digit activation code input (always LTR)"],
    "typography": "ARABIC-SCRIPT font family, line-height 1.65, no letter-spacing, minimum body 15px; Urdu may use Noto Nastaliq only for display titles, never for table cells",
    "numerals": "Western digits (the ERP does not localise digits)",
    "languages": { "en": "English (LTR)", "ur": "اردو (RTL)", "ar": "العربية (RTL)", "fa": "فارسی (RTL)", "ps": "پښتو (RTL)" }
  }
}
