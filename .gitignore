android/app/src/main/assets/public/cache/
android/.gradle/
android/app/build/
android/build/
ios/Pods/
ios/build/

# Backups & Logs
.codex-backups/
.codex*
_codex*
backups/
exports/
*.log
api-error-log.txt
*-log.txt
*.pack
*.gz
*.tar
*.zip

# Environment & Secrets
.env
.env.local
.env.production
.env.development
.env*.local

# Keep environment templates & blueprints tracked
!env_backups/*.example
!.env.example

# Local-only script output (never deploy — see scripts/generate-country-users-pdf.mjs)
/local-output/

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# AI Document Intake — vendored OCR assets (run: npm run ocr:vendor) + private intake storage
vendor/ocr/
storage/document-intake/

# tesseract.js cwd cache
*.traineddata
uat-samples/

# Local verification scratch space & temp files (never commit — may contain session cookies / DB dumps)
scratch/
tmp/
.tmp/
*.tmp
*.bak
*.patch
*.diff
.eslintcache
_scratch_prototype_preview.html
supabase/backups/.env*
# Database dumps must never be committed — they carry real credentials / PII
supabase/backups/*.json
supabase/backups/*.sql
supabase/backups/*.dump
# Capacitor copies a built Next.js bundle here on `npx cap sync`; it is a build
# artifact (and the app loads server.url remotely), never source of truth
android/app/src/main/assets/public/server/

# Sneat design source package (large, local-only reference for Phase 2)
design-assets/

# Local incremental TypeScript build cache — regenerates every tsc run and
# should never be tracked (was causing spurious "dirty tree" deploy aborts)
*.tsbuildinfo

# Android SDK location (machine specific)
android/local.properties
android/capacitor-cordova-android-plugins/build/

# generated store screenshots (kept in the owner folder, not in git)
docs/store/screenshots/

# mobile design concepts: generated outputs (boards, PNGs, Figma plugin bundle) are rebuilt by build.mjs / export-figma-scene.mjs
docs/design/mobile-concepts/dist/
docs/design/mobile-concepts/figma-plugin/

# never track credential documents or database backups (see scripts/repo-safety-guard.mjs)
/public/downloads/*CREDENTIAL*
*CREDENTIALS*.pdf
/backups/*.json
