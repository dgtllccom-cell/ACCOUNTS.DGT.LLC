# App Store listing + submission for DGT.llc B through the App Store Connect API (no Apple ID login, no Mac).
# Run by .github/workflows/ios-appstore-submit.yml. Secrets come from the environment and are never printed.
default_platform(:ios)

platform :ios do
  lane :store do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      in_house: false
    )
    submit = ENV["SUBMIT"] == "true"
    # Fastfile Ruby runs inside ./fastlane while actions run from the repo root: use absolute paths.
    here = File.expand_path(__dir__)
    notes = File.read(File.join(here, "review_notes.txt")).gsub("<REVIEW-CODE>", ENV.fetch("ASC_REVIEW_CODE", ""))
    deliver(
      api_key: api_key,
      app_identifier: "com.dgtllc.b",
      app_version: ENV.fetch("APP_VERSION", "1.0"),
      build_number: ENV["BUILD_NUMBER"].to_s.empty? ? nil : ENV["BUILD_NUMBER"],
      skip_binary_upload: true,
      metadata_path: File.join(here, "metadata"),
      screenshots_path: File.join(here, "screenshots"),
      overwrite_screenshots: true,
      copyright: "© 2026 DAMAAN GENERAL TRADING L.L.C",
      primary_category: "BUSINESS",
      secondary_category: "PRODUCTIVITY",
      app_rating_config_path: File.join(here, "age_rating.json"),
      app_review_information: {
        first_name: ENV.fetch("ASC_CONTACT_FIRST_NAME", "DGT"),
        last_name: ENV.fetch("ASC_CONTACT_LAST_NAME", "Support"),
        phone_number: "+971544816664",
        email_address: "support@dgt.llc",
        demo_account_required: true,
        demo_user: ENV.fetch("ASC_REVIEW_EMAIL", ""),
        demo_password: ENV.fetch("ASC_REVIEW_PASSWORD", ""),
        notes: notes
      },
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      },
      submit_for_review: submit,
      automatic_release: true,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
