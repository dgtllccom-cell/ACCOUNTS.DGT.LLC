# ============================================================================
# Digital Dock ERP — Environment Variables (EXAMPLE / TEMPLATE)
# Copy this file to `.env.local` for local dev, and set the real values in the
# VPS environment (e.g. ecosystem.config.cjs env / server env). This example
# contains PLACEHOLDERS ONLY — never commit real secrets to git.
# ============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# IMPORTANT — must be the REAL Supabase SERVICE ROLE secret.
# Get it from: Supabase Dashboard -> Project Settings -> API -> "service_role" (secret).
# It is a long "eyJ..." JWT (or an "sb_secret_..." key).
# It MUST NOT be a "sb_publishable_..." (anon) key. If the anon key is used here,
# the server admin client runs with anon privileges and Row Level Security (RLS)
# blocks every privileged read -> reports show 0 / "No country records" / blank pages.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
# Optional alias also accepted by the app:
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# --- Database (PostgreSQL / Supabase pooler) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# --- Optional: monitoring / domain checks ---
# MONITOR_DOMAIN=your-domain.com
# GITHUB_TOKEN=your_github_pat
# GITHUB_REPO=owner/repo
