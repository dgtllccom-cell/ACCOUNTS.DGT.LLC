{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "..\\..\\..\\AppData\\Local\\Temp\\dgt-nextjs\\.next/types/**/*.ts",
    ".next-codex-dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify2/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify3/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".sdfghj",
    "android",
    "ios",
    "scripts",
    ".tmp",
    "tmp",
    "backups",
    ".codex-worktree-merge-backup",
    "fix-broken-transfers.ts",
    "check-superadmins.ts",
    "check_roznamcha.ts"
  ]
}
