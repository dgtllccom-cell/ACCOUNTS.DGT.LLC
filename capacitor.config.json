{
  "appId": "com.digitaldock.erp",
  "appName": "Digital Dock ERP",
  "webDir": "public",
  "server": {
    "url": "https://api.dgt.llc",
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": ["api.dgt.llc", "*.dgt.llc"]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f3ea8",
      "showSpinner": false,
      "androidSpinnerStyle": "large",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0f3ea8",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
