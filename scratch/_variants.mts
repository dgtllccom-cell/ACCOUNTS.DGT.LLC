        { label: "Company Type", value: D("Private Limited") }, { label: "Company Reg. No.", value: D("-") },
        { label: "Incorporation Date", value: D("-") }, { label: "Status", value: "Active" },
        { label: "Registered Office", value: D("Office 3, Zarghoon Road, Quetta, Pakistan") },
