{
	"appId": "com.dgtllc.b",
	"appName": "DGT.llc B",
	"webDir": "mobile-shell",
	"appendUserAgent": "DGTllc-B/1",
	"android": {
		"allowMixedContent": false,
		"captureInput": true
	},
	"ios": {
		"contentInset": "always",
		"limitsNavigationsToAppBoundDomains": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"backgroundColor": "#0f3ea8",
			"showSpinner": false,
			"androidSpinnerStyle": "large",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#0f3ea8",
			"overlaysWebView": false
		},
		"Keyboard": {
			"resize": "native",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"server": {
		"url": "https://api.dgt.llc/auth/login",
		"androidScheme": "https",
		"iosScheme": "https",
		"allowNavigation": [
			"api.dgt.llc"
		],
		"errorPath": "offline.html"
	}
}
