// minimal: only ~10 permissions
const few = getPermissionKeysForTemplate("country-standard").slice(0, 9);
fs.writeFileSync("public/_print_preview/cb-minimal.html", make("en", few, "Pakistan Main Branch", true));
fs.writeFileSync("public/_print_preview/cb-urdu.html", make("ur", getPermissionKeysForTemplate("country-standard"), "پاکستان مرکزی برانچ", false));
console.log("minimal perms:", buildPermissionPrintSummary(few).grantedCount, "/", buildPermissionPrintSummary(few).totalCount);
console.log("wrote cb-minimal.html + cb-urdu.html");
