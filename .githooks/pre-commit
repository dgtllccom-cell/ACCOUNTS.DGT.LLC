#!/bin/sh
# Digital Dock ERP — five-language guard (see docs/multilingual-architecture.md).
# Enable once with:  git config core.hooksPath .githooks   (or run `npm install`)
#
# Blocks a commit that breaks dictionary parity, references a missing key,
# ships silent English, adds a NEW parallel per-module dictionary, or introduces
# NEW hard-coded English strings in the staged files.

echo "• repo safety guard (plaintext credentials / destructive identity scripts)…"
node scripts/repo-safety-guard.mjs --staged || {
  echo ""
  echo "✗ commit blocked: a plaintext credential or a destructive auth/identity"
  echo "  script must not enter version control. Rotate via the Supabase dashboard;"
  echo "  do user cleanup through a reviewed, guarded migration — not a scripts/*.mjs."
  exit 1
}

# Auto-generate UR/AR/FA/PS for any NEW English-only key in a staged ui.ts change,
# so a new form/page/module/report only needs its English string (see
# docs/auto-i18n-engine.md). Deterministic ERP glossary + local engine offline;
# add AI_TRANSLATE_PROVIDER + AI_TRANSLATE_API_KEY for full coverage. Anything the
# engine cannot render cleanly is left in English and the guard below still blocks.
if git diff --cached --name-only | grep -q '^lib/i18n/ui\.ts$'; then
  echo "• i18n autofill (staged ui.ts — generating missing languages)…"
  node_modules/.bin/vite-node --config vitest.config.mjs scripts/i18n-autofill.mts -- --staged || true
  git add lib/i18n/ui.ts lib/i18n/ui.autofill-provenance.json 2>/dev/null || true
fi

echo "• i18n five-language guard…"
node scripts/i18n-ui-guard.mjs --changed || {
  echo ""
  echo "✗ commit blocked by the i18n guard."
  echo "  Fix: add the key to lib/i18n/ui.ts in ALL FIVE blocks (en/ur/ar/fa/ps),"
  echo "  or wrap the string with useErpScreen().t(\"key\", \"English fallback\")."
  echo "  Bypass only if you are certain:  git commit --no-verify"
  exit 1
}

echo "• multilingual business-data contract guard…"
node scripts/multilingual-contract-guard.mjs --quiet || {
  echo ""
  echo "✗ commit blocked by the multilingual contract guard."
  echo "  A new form/table/route/report must enter the contract: classify every"
  echo "  user-facing text column in lib/i18n/translatable-fields.ts (translate /"
  echo "  transliterate) and resolve the viewer language with getRequestLanguage()"
  echo "  + localizeRecordFields / localizeJoinedNames."
  echo "  Bypass only if you are certain:  git commit --no-verify"
  exit 1
}

echo "• navigation duplicate guard (Main Menu)…"
node scripts/nav-duplicate-guard.mjs || {
  echo ""
  echo "✗ commit blocked: the Main Menu has a repeated destination or key."
  echo "  Keep ONE canonical entry per function. A distinct ?tab=/filter is fine."
  echo "  Bypass only if you are certain:  git commit --no-verify"
  exit 1
}
